# Chiavi/API opzionali per le funzioni edge in api/sources
# Nessuna di queste va mai esposta al client: usarle solo lato server/edge.

# opentransportdata.swiss (registrazione gratuita per rate limit piu' alti)
OPENTRANSPORTDATA_API_KEY=

# Provider dati finanziari (es. Twelve Data / Alpha Vantage)
FINANCE_API_KEY=

# Redis/Upstash per la cache lato edge
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=
